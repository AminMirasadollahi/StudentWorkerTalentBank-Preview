# SWTB22 coordinated operational UI release (public non-secret Vite feature flags).
# Retain the protected .github/workflows/pages.yml byte-for-byte.
# Independent D3 rollback: VITE_SWTB22_TASKS_FOCUS_UI=false.
# Independent D4 rollback: VITE_SWTB22_PRESENCE_FOCUS_UI=false.
# Independent D5 rollback: VITE_SWTB22_REVIEW_FOCUS_UI=false.
# For any feature toggle, redeploy main after normal protected review.
# To roll back the entire SWTB22 shell, separately disable the manager/work-pool flags.
# This is presentation-only; never add credentials, Supabase secrets, or auth grants.
VITE_SWTB22_MANAGER_SHELL_UI=true
VITE_SWTB22_WORK_POOL_FOCUS_UI=true
VITE_SWTB22_TASKS_FOCUS_UI=true
VITE_SWTB22_PRESENCE_FOCUS_UI=true
VITE_SWTB22_REVIEW_FOCUS_UI=true
